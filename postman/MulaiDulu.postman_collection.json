{
  "info": {
    "name": "MulaiDulu REST API",
    "description": "Pengujian endpoint autentikasi dan CRUD Tasks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "01 - Login",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/login",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{demo_email}}\",\n  \"password\": \"{{demo_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.environment.set(\"token\", pm.response.json().token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - List Tasks",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/tasks",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "03 - Create Task",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/tasks",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Mengerjakan laporan UTS\",\n  \"first_step\": \"Buka dokumen dan tulis judul\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Create 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  pm.environment.set(\"task_id\", String(pm.response.json().data.id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Task Detail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/tasks/{{task_id}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "05 - Update Task",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/api/tasks/{{task_id}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Laporan UTS diperbarui\",\n  \"status\": \"in_progress\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 - Validation 422",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/tasks",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"status\": \"invalid\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 - Delete Task",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/tasks/{{task_id}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "08 - Detail After Delete 404",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/tasks/{{task_id}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "09 - Logout",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/logout",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "10 - Revoked Token 401",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/user",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "11 - No Token 401",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/tasks",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      }
    }
  ]
}
